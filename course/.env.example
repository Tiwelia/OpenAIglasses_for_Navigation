# 复制为 course/.env，填写实际密钥。不要将填写后的文件交作业或公开。
# 若本文件没有单独配置，程序也会读取原工程根目录.env中的密钥。
DASHSCOPE_API_KEY=
COURSE_MODEL=qwen3.8-flash
COURSE_ASR_MODEL=qwen3-asr-flash
# Beijing example; use the matching region/workspace URL from your console.
COURSE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
COURSE_AI_TIMEOUT=25
COURSE_PORT=8081
COURSE_AI_ENABLED=0
